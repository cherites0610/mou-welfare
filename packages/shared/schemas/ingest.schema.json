{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "source": {
      "type": "object",
      "properties": {
        "site_id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$"
        },
        "city": {
          "type": "string",
          "minLength": 2
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "kind": {
          "type": "string",
          "enum": [
            "cms",
            "opendata",
            "portal"
          ]
        }
      },
      "required": [
        "site_id",
        "city",
        "url",
        "kind"
      ]
    },
    "program_key": {
      "type": "string",
      "minLength": 3
    },
    "title": {
      "type": "string",
      "minLength": 4
    },
    "published_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "content_md": {
      "type": "string",
      "minLength": 80
    },
    "attachments": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "url",
          "text"
        ]
      }
    },
    "structured": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "classification": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "program",
            "announcement",
            "minutes",
            "procurement",
            "org_grant",
            "event",
            "statistics",
            "other"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "type",
        "confidence"
      ]
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "required": [
    "source",
    "program_key",
    "title",
    "published_at",
    "content_md",
    "classification",
    "content_hash"
  ]
}
